# Cistem environment variables — copy this file to `backend/.env` for local development.
#   cp .env.example backend/.env
# Never commit real secrets. Deployment environments provide these variables directly.

# ── Backend ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma-separated list of allowed browser origins (CORS allow-list).
CORS_ORIGINS=http://localhost:5173

# PostgreSQL connection (matches docker-compose.yml).
DATABASE_URL=postgresql://cistem:cistem@localhost:5432/cistem

# ── AI provider (CONFIGURABLE; BLOCKED until credentials exist — P7/P8) ──────
# The app must run fully with these unset. Provider values: openai-compatible | ollama.
AI_PROVIDER=
AI_MODEL=
AI_VISION_MODEL=
AI_BASE_URL=
AI_API_KEY=
AI_TIMEOUT_MS=30000

# ── Frontend (Vite — only VITE_* values are exposed to the browser) ──────────
# Leave empty to use the Vite dev proxy (`/api` → http://localhost:4000).
VITE_API_BASE_URL=

# ── Authentication (BLOCKED until configured — P9) ───────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_JWT_ISSUER=
